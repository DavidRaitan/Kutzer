{
  "name": "zichru-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Zichru — Talmud Mastery (single-file web app + local dev server)",
  "scripts": {
    "start": "node server.js",
    "login:firebase": "npx firebase-tools login",
    "serve": "npx firebase-tools serve --only hosting --project tracking-app-0001",
