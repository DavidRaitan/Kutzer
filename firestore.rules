rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tractates/{tractateId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /dafim/{dafId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
